# Configurações do Sistema de Chamados - Colégio Mauá

# Ambiente: development | production
FLASK_ENV=development

# Chave secreta para sessões (gerar uma nova em produção)
SECRET_KEY=sua-chave-secreta-aqui

# Banco de dados (SQLite padrão)
# IMPORTANTE: deixe comentado! O config.py monta o caminho absoluto
# automaticamente (necessário para funcionar em caminhos de rede).
#DATABASE_URL=sqlite:///database/chamados.db

# ──────────────────────────────────────────────────────────
# Assistente de TI (IA) — responde automaticamente no chat
# ──────────────────────────────────────────────────────────
# true = IA ativa | false = IA desligada
IA_ASSISTENTE_ATIVO=true

# URL da API — Gemini no formato compatível com OpenAI
IA_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# SUA CHAVE DA API DO GEMINI (obrigatória para a IA funcionar)
# Gere em: https://aistudio.google.com/apikey
IA_API_KEY=MINHA_CHAVE_API
#API cadastrada no email: lovangoulart@gmail.com

# Modelo de IA
IA_MODEL=gemini-3.5-flash
IA_MODEL_FALLBACK=gemini-3.5-flash-lite
IA_MODEL_FALLBACK_2=gemini-3.1-flash-lite